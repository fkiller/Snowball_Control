{
    "manufacturer": "SYK",
    "keyboard_name": "syk_keyboards",
    "maintainer": "SYK",
    "bootloader": "stm32duino",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "command": false,
        "console": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": false,
        "rgb_matrix": false
    },
    "matrix_pins": {
        "direct": [
            ["A15", "B15", "B0", "A7", "A0"],  
            ["B3", "B14", "B1", "A6", "A1"],  
            ["B8", "B13", "B10", "A5", "A2"],  
            ["B9", "B12", "B11", "A4", "A3"]
          ]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "B6", "pin_b": "B7"},
            {"pin_a": "C14", "pin_b": "C15"}
        ]
    },
    "processor": "STM32F103",
    "url": "https://binepad.com",
    "usb": {
        "vid": "0x4250",
        "pid": "0x426F",
        "device_version": "1.0.0"
    },
    "eeprom": {
        "wear_leveling": {
            "backing_size": 4096
        }
    },
    "ws2812": {
        "pin": "B15"
    },
    "rgb_matrix": {
        "driver": "ws2812",
        "layout": [
            {"flags": 4, "matrix": [0, 0], "x": 0, "y": 0},
        ]
    },
    "layouts": {
        "LAYOUT_ortho_6x3": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [0, 4], "x": 4, "y": 0},

                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [1, 3], "x": 3, "y": 1},
                {"matrix": [1, 4], "x": 4, "y": 1},

                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2},
                {"matrix": [2, 3], "x": 3, "y": 2},
                {"matrix": [2, 4], "x": 4, "y": 2},

                {"matrix": [3, 0], "x": 0, "y": 3},
                {"matrix": [3, 1], "x": 1, "y": 3},
                {"matrix": [3, 2], "x": 2, "y": 3},
                {"matrix": [3, 3], "x": 3, "y": 3},
                {"matrix": [3, 4], "x": 4, "y": 3}
            ]
        }
    }
}
